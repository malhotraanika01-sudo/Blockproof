# ─── Database ───────────────────────────────────────────────
# Matches docker-compose.yml service "postgres" (host port 5433 to avoid a
# clash with a locally-installed PostgreSQL already using 5432).
DATABASE_URL="postgresql://blockproof:blockproof@localhost:5433/blockproof?schema=public"

# ─── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Auth ───────────────────────────────────────────────────
# Generate a real value: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ─── Evidence encryption ────────────────────────────────────
# AES-256-GCM master key, 32 bytes hex (64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_ENC_KEY=replace-me-with-64-hex-chars

# Where AES-GCM ciphertext blobs are written (git-ignored)
EVIDENCE_STORAGE_DIR=./storage

# Upload limits
MAX_UPLOAD_MB=25
ALLOWED_MIME=image/jpeg,image/png,image/webp,video/mp4,audio/mpeg,audio/wav,application/pdf,text/plain

# ─── Ledger ─────────────────────────────────────────────────
# "mock"  -> in-process simulated ledger (default; works with no Docker)
# "fabric" -> Hyperledger Fabric via fabric-network gateway
LEDGER_DRIVER=mock
FABRIC_CHANNEL=blockproofchannel
FABRIC_CHAINCODE=blockproof
FABRIC_CONNECTION_PROFILE=../fabric/organizations/peerOrganizations/org1.example.com/connection-org1.json
FABRIC_WALLET_DIR=../fabric/wallet
FABRIC_IDENTITY=appUser
FABRIC_MSP_ID=Org1MSP
